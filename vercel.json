{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/analyze-catalog.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/ventas", "destination": "https://venta-de-activos-bia.lovable.app/", "permanent": false },
    { "source": "/sales", "destination": "https://venta-de-activos-bia.lovable.app/", "permanent": false },
    { "source": "/sales.html", "destination": "https://venta-de-activos-bia.lovable.app/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/" },
    { "source": "/registro", "destination": "/register" },
    { "source": "/inicio", "destination": "/home" },
    { "source": "/proveedores", "destination": "/providers" },
    { "source": "/cotizaciones", "destination": "/quotes" },
    { "source": "/comparativo", "destination": "/compare" }
  ]
}
